<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <Version>0.0.10</Version>

    <Description>Интеграционные тесты</Description>

    <PackageLicenseFile>LICENSE</PackageLicenseFile>

    <PackageProjectUrl>https://github.com/Rokoth/TaskCollector</PackageProjectUrl>

    <RepositoryUrl>https://github.com/Rokoth/TaskCollector</RepositoryUrl>

    <RepositoryType>git</RepositoryType>

    <PackageId>TaskCollector.IntegrationTests</PackageId>

    <Title>Интеграционные тесты TaskCollector</Title>

    <Authors>Dmitriy Rokoth</Authors>

